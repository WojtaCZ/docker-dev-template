{
    "name": "dev-template-baseline",
    "build": {
        "context": "..",
        "dockerfile": "../Dockerfile"
    },
    "remoteUser": "dev",
    "workspaceFolder": "/workspace",
    "workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind,consistency=cached",

    "mounts": [
        "source=${localEnv:HOME}/.claude.json,target=/host-claude-auth.json,type=bind",
        "source=${localEnv:HOME}/.claude,target=/host-claude-dir,type=bind"
    ],

    "runArgs": ["--init"],

    "postCreateCommand": "bash /usr/local/bin/post-create.sh",

    "customizations": {
        "vscode": {
            "extensions": [
                "anthropic.claude-code",
                "eamodio.gitlens",
                "ms-azuretools.vscode-docker",
                "github.vscode-pull-request-github"
            ],
            "settings": {
                "terminal.integrated.defaultProfile.linux": "bash"
            }
        }
    }
}
