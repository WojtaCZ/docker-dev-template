# Shell scripts and Dockerfiles MUST have LF line endings — they run inside Linux
# containers and CRLF breaks the shebang (`/usr/bin/env\r: No such file or directory`).
*.sh            text eol=lf
Dockerfile      text eol=lf
*.json          text eol=lf
*.md            text eol=lf
.gitignore      text eol=lf
.gitattributes  text eol=lf
*.ps1           text eol=crlf
*.yml           text eol=lf
*.yaml          text eol=lf
